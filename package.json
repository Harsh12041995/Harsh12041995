{
  "name": "whatsapp-ai-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run bot",
    "bot": "tsx src/index.ts",
    "bot:fresh": "lsof -ti :3001 | xargs kill -9 2>/dev/null; tsx src/index.ts",
    "dashboard": "vite",
    "build": "vite build",
    "kill-port": "lsof -ti :3001 | xargs kill -9 2>/dev/null && echo 'Port 3001 cleared'"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^9.3.1",
    "ollama": "^0.5.0",
    "qrcode-terminal": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.9",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "@vitejs/plugin-react": "^4.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  }
}
